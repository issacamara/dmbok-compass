# Shared development configuration. Copy to .env before running Compose.
GOOGLE_CLOUD_PROJECT=dev-dmbok-compass
GOOGLE_CLOUD_LOCATION=europe-west1
RAG_VECTOR_COLLECTION=document_chunks_v2
RAG_VECTOR_SCHEMA_VERSION=2
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_RETRIEVAL_STRATEGY=dense
ANSWER_PROVIDER=openrouter
ANSWER_REQUEST_TIMEOUT_MS=14000
ANSWER_GENERATION_TIMEOUT_MS=8000
ANSWER_OUTPUT_TOKEN_CAP=1024
ANSWER_MAX_MODEL_ATTEMPTS=2
RUNTIME_SECRET_VERSION=local-dev
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=mistralai/mistral-nemo
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_JSON_SCHEMA_SUPPORTED=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to 127.0.0.1:9099 only when the Firebase Auth emulator is running.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
